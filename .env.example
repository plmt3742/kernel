# KERNEL 环境变量模板
# 下列变量由程序从进程环境读取。本文件仅作清单与占位示例，
# 请按其中的名称在运行环境中设置，切勿填入真实密钥后提交。

# DeepSeek API Key（opencode 调用 AI 时使用）。
# 也可在应用「设置 → AI 集成」中填写，保存在本机 data/meta/secrets.json（已加入 .gitignore），
# 此时无需在此重复填写。
DEEPSEEK_API_KEY=your-key-here

# 本地数据服务与 opencode serve 之间的访问口令（纵深防御，可留空）。
OPENCODE_SERVER_PASSWORD=your-password-here

# opencode serve 地址（默认 127.0.0.1:4096）。
KERNEL_OPENCODE_URL=http://127.0.0.1:4096

# 指定 opencode 可执行文件路径（留空则从系统 PATH 查找）。
KERNEL_OPENCODE_BIN=
